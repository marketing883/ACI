# ACI staging environment template.
#
# Copy this file to `.env.staging` on the staging VPS inside the
# Next.js app directory (`/var/www/aci-staging/aci-infotech/`) and
# fill in the real values. `.env.staging` is gitignored; never
# commit it.
#
# `npm run build` reads these variables at build time (via systemd's
# EnvironmentFile, or inline if running the build by hand). The
# prebuild env-check script aborts the build if any required value
# is missing.

# === v2 homepage switch =====================================
# Must be exactly "true" to make / render the v2 homepage on this
# build. Any other value (or unset) and / falls back to v1.
NEXT_PUBLIC_USE_V2_HOME=true

# === Required for every build ===============================
# Absolute URL this build serves from. Do NOT use localhost here —
# the prebuild check will reject that.
NEXT_PUBLIC_SITE_URL=https://staging.aciinfotech.com

# Supabase — same project as prod in most cases; use a separate
# staging project if you want data isolation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Optional (only if these features are used on staging) ==
# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cal.com
CAL_COM_API_KEY=
CAL_COM_BOOKING_URL=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=

# DataForSEO
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Security
JWT_SECRET=

# Atheros copilot (leave as-is unless changing rollout %)
NEXT_PUBLIC_COPILOT_V2=true
NEXT_PUBLIC_COPILOT_V2_PERCENT=100
