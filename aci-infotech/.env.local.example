# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.

# AI APIs
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cal.com
CAL_COM_API_KEY=cal_live_...
CAL_COM_BOOKING_URL=https://cal.com/your-booking/30min

# Mailchimp (Email)
MAILCHIMP_API_KEY=...
MAILCHIMP_SERVER_PREFIX=us5

# Resend (transactional email: lead notifications, thank-you mails)
# Without RESEND_API_KEY nothing is sent and the site only logs the payload.
RESEND_API_KEY=re_...
# Sender. Its domain must be verified in Resend (SPF/DKIM) or sends fail.
FROM_EMAIL=ACI Infotech <noreply@aciinfotech.com>
# Who gets lead notifications (landing pages, whitepapers, event
# registrations). Comma-separated for more than one inbox.
#
# Use an address OFF the sending domain. Mail from noreply@aciinfotech.com to
# an @aciinfotech.com mailbox reaches Google Workspace from an outside relay
# and gets quarantined as spoofing, so the notification silently never lands
# while the same send to an outside domain is delivered. That is exactly how
# the AION 2026 registrations went unnoticed.
ADMIN_EMAIL=marketing@aciinfotech.net

# DataForSEO API
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Vercel
VERCEL_TOKEN=

# Security
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Atheros copilot v2
NEXT_PUBLIC_COPILOT_V2=true
NEXT_PUBLIC_COPILOT_V2_PERCENT=100

# TapResume careers integration
# (docs/integrations/TAPRESUME-CAREERS-CONTRACT-2026-08-30.md).
# Dedicated HMAC signing secret - never a Supabase key, never reused.
# Provisioned out of band by the TapResume operator; see the contract doc.
TAPRESUME_SIGNING_SECRET=
# During rotation only: the incoming secret, accepted alongside the current
# one until TapResume switches over, then promoted.
TAPRESUME_SIGNING_SECRET_NEXT=
