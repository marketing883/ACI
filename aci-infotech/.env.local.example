# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.

# AI APIs
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cal.com
CAL_COM_API_KEY=cal_live_...
CAL_COM_BOOKING_URL=https://cal.com/your-booking/30min

# Mailchimp (Email)
MAILCHIMP_API_KEY=...
MAILCHIMP_SERVER_PREFIX=us5

# DataForSEO API
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Vercel
VERCEL_TOKEN=

# Security
JWT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Atheros copilot v2
NEXT_PUBLIC_COPILOT_V2=true
NEXT_PUBLIC_COPILOT_V2_PERCENT=100
