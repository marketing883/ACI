[Unit]
Description=ACI staging auto-deploy (poll branch, rebuild, restart)
Documentation=file:///var/www/aci-staging/aci-infotech/aci-infotech/docs/staging.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aciadmin
WorkingDirectory=/var/www/aci-staging/aci-infotech
ExecStart=/var/www/aci-staging/aci-infotech/aci-infotech/scripts/staging-autodeploy.sh

# This box hosts other sites. A Next.js build is memory and CPU hungry,
# so it runs de-prioritised and capped: it can be slow, but it must not
# starve or OOM anything else running here.
Nice=10
CPUWeight=20
IOSchedulingClass=idle
MemoryMax=3G
TasksMax=512

# A stuck npm install should not hold the timer open forever.
TimeoutStartSec=1800

# /usr, /boot and /etc stay read-only.
ProtectSystem=full

# This box hosts other sites, including production, which a different
# operator deploys independently. Make that a kernel-enforced boundary
# rather than a promise: everything under /var/www is read-only to this
# unit except the staging tree. A bug in the deploy script cannot write
# to /var/www/aci-prod or any other vhost even if it tried.
# (ReadWritePaths is applied after ReadOnlyPaths, so the narrower rule
# wins.)
ReadOnlyPaths=/var/www
ReadWritePaths=/var/www/aci-staging

PrivateTmp=true

# Home stays writable on purpose: npm needs its cache at ~/.npm, and
# locking that down breaks `npm ci`.

# Must stay false: the script escalates via one narrow sudoers rule to
# restart the staging unit.
NoNewPrivileges=false
