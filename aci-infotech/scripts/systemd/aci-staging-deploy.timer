[Unit]
Description=Poll for ACI staging deploys every 5 minutes

[Timer]
# Give the box a few minutes after boot before the first poll.
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
# Don't stampede if several units come due at once.
RandomizedDelaySec=45s
Unit=aci-staging-deploy.service

[Install]
WantedBy=timers.target
