[Unit]
Description=ACI production deploy hook
After=network.target

[Service]
Type=simple
User=aciadmin
Group=aciadmin
EnvironmentFile=/etc/aci-deploy.env
Environment=ACI_HOOK_HOST=127.0.0.1
Environment=ACI_HOOK_PORT=9099
Environment=ACI_SERVICE=aci-next.service
Environment=ACI_HEALTH_PORT=3002
ExecStart=/usr/local/bin/aci-deploy-hook
Restart=on-failure
RestartSec=5

# It runs a build and restarts a unit, so it cannot be locked down as hard
# as a pure network service. These are the restrictions that still hold.
#
# The kernel-protection options that used to be here are gone, and the
# reason is not cosmetic. ProtectKernelTunables, ProtectKernelModules,
# ProtectControlGroups, RestrictSUIDSGID and LockPersonality each imply
# NoNewPrivileges=yes, and systemd's implication overrides the explicit
# `no` below. NoNewPrivileges blocks setuid entirely, so `sudo systemctl
# restart` inside this unit fails with "the no new privileges flag is
# set" - the sudoers rule is correct but unreachable, and every deploy
# builds fine then dies at the restart.
#
# The controls that actually gate this endpoint are untouched: it runs as
# aciadmin rather than root, binds to loopback only, authenticates a
# bearer token, and can escalate to exactly one command via
# /etc/sudoers.d/gha-deploy.
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no

[Install]
WantedBy=multi-user.target
